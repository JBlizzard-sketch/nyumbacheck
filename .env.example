# ============================================================
# NyumbaCheck — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/nyumbacheck
REDIS_URL=redis://localhost:6379/0

# --- Node API Server ---
PORT=3000
NODE_ENV=development

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- M-Pesa (Safaricom Daraja API) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox  # sandbox | production

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@nyumbacheck.co.ke

# --- SMS (Africa's Talking) ---
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SHORTCODE=

# --- Object Storage (Cloudflare R2 or AWS S3) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nyumbacheck-assets
R2_ACCOUNT_ID=
R2_PUBLIC_URL=https://assets.nyumbacheck.co.ke

# --- Scraper ---
SCRAPER_PROXY_URL=  # Optional rotating proxy URL
SCRAPER_USER_AGENT=NyumbaCheckBot/1.0 (+https://nyumbacheck.co.ke/bot)
SCRAPER_RATE_LIMIT_RPS=0.5  # Requests per second per domain
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_MAX_RETRIES=3

# --- Python FastAPI ---
PYTHON_API_PORT=8000
PYTHON_API_HOST=0.0.0.0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=info

# --- GitHub (CI/CD only) ---
GITHUB_PERSONAL_ACCESS_TOKEN=
